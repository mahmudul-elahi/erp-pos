generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  phone            String?      @unique
  passwordHash     String       @map("password_hash")
  name             String
  status           UserStatus   @default(ACTIVE)
  isSuperAdmin     Boolean      @default(false) @map("is_super_admin")
  refreshTokenHash String?      @map("refresh_token_hash")
  lastLoginAt      DateTime?    @map("last_login_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  roles                     UserRole[]
  branches                  UserBranch[]
  auditLogs                 AuditLog[]
  uploadedFiles             FileRecord[]
  stockMovementsCreated     StockMovement[]
  stockAdjustmentsCreated   StockAdjustment[]   @relation("AdjustmentsCreated")
  stockAdjustmentsConfirmed StockAdjustment[]   @relation("AdjustmentsConfirmed")
  stockTransfersCreated     StockTransfer[]     @relation("TransfersCreated")
  stockTransfersDispatched  StockTransfer[]     @relation("TransfersDispatched")
  stockTransfersReceived    StockTransfer[]     @relation("TransfersReceived")
  stockTransfersCancelled   StockTransfer[]     @relation("TransfersCancelled")
  damagedProductsReported   DamagedProduct[]
  purchasesCreated          Purchase[]          @relation("PurchasesCreated")
  purchasesReceived         Purchase[]          @relation("PurchasesReceived")
  purchasePaymentsCreated   PurchasePayment[]
  purchaseReturnsCreated    PurchaseReturn[]
  shifts                    CashRegisterShift[]
  shiftCashMovementsCreated ShiftCashMovement[]
  salesCreated              Sale[]              @relation("SalesCreated")
  saleReturnsCreated        SaleReturn[]
  ordersCreated             Order[]             @relation("OrdersCreated")
  orderStatusChanges        OrderStatusHistory[]
  shipmentsCreated          CourierShipment[]   @relation("ShipmentsCreated")
  cashTransactionsCreated   CashAccountTransaction[] @relation("CashTransactionsCreated")
  expensesCreated           Expense[]           @relation("ExpensesCreated")
  buybacksInspected         DeviceBuybackRequest[] @relation("BuybacksInspected")
  buybacksCreated           DeviceBuybackRequest[] @relation("BuybacksCreated")
  warrantyClaimsCreated     WarrantyClaim[]     @relation("WarrantyClaimsCreated")
  assignedTelesalesLeads    TelesalesLead[]       @relation("AssignedTelesalesLeads")
  createdTelesalesLeads     TelesalesLead[]       @relation("CreatedTelesalesLeads")
  telesalesCallLogs         TelesalesCallLog[]    @relation("TelesalesAgentLogs")
  partnersCreated           Partner[]             @relation("PartnersCreated")
  partnerLedgerCreated      PartnerLedgerEntry[]  @relation("PartnerLedgerCreated")
  directorTxCreated         DirectorTransaction[] @relation("DirectorTxCreated")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Branch {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true) @map("is_active")
  isMain    Boolean   @default(false) @map("is_main")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  warehouses            Warehouse[]
  userBranches          UserBranch[]
  auditLogs             AuditLog[]
  customerLedgerEntries CustomerLedgerEntry[]
  supplierLedgerEntries SupplierLedgerEntry[]
  purchases             Purchase[]
  shifts                CashRegisterShift[]
  sales                 Sale[]
  saleReturns           SaleReturn[]
  orders                Order[]
  cashAccounts          CashAccount[]
  expenses              Expense[]
  partners              Partner[]

  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid())
  branchId  String?   @map("branch_id")
  name      String
  code      String    @unique
  location  String?
  isDefault Boolean   @default(false) @map("is_default")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branch               Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  inventoryBalances    InventoryBalance[]
  stockMovements       StockMovement[]
  stockAdjustments     StockAdjustment[]
  transfersOut         StockTransfer[]    @relation("SourceTransfers")
  transfersIn          StockTransfer[]    @relation("DestinationTransfers")
  damagedProducts      DamagedProduct[]
  purchases            Purchase[]
  purchaseReturns      PurchaseReturn[]
  sales                Sale[]
  saleReturns          SaleReturn[]
  orders               Order[]

  @@map("warehouses")
}

model UserBranch {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  branchId   String   @map("branch_id")
  isDefault  Boolean  @default(false) @map("is_default")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  branchId   String?  @map("branch_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([branchId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FileRecord {
  id           String    @id @default(uuid())
  originalName String    @map("original_name")
  objectKey    String    @unique @map("object_key")
  bucket       String
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  extension    String
  uploadedById String?   @map("uploaded_by_id")
  module       String
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  isPrivate    Boolean   @default(false) @map("is_private")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  uploadedBy      User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productImages   ProductImage[]
  expenses        Expense[]
  banners         StorefrontBanner[]
  promotionOffers PromotionOffer[]

  @@index([module, entityType, entityId])
  @@index([uploadedById])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Phase 2: Product Catalog Models
// ---------------------------------------------------------------------------

enum ProductType {
  PHYSICAL
  SERVICE
  BUNDLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BarcodeType {
  CODE128
  EAN13
  UPC
  QR
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  parentId    String?   @map("parent_id")
  image       String?
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@map("brands")
}

model Attribute {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid())
  attributeId String   @map("attribute_id")
  value       String
  code        String?
  createdAt   DateTime @default(now()) @map("created_at")

  attribute     Attribute                     @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues ProductVariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model Product {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  description    String?
  categoryId     String        @map("category_id")
  brandId        String?       @map("brand_id")
  sku            String        @unique
  barcode        String?       @unique
  type           ProductType   @default(PHYSICAL)
  status         ProductStatus @default(DRAFT)
  costPrice      Decimal       @default(0) @map("cost_price") @db.Decimal(18, 2)
  sellingPrice   Decimal       @default(0) @map("selling_price") @db.Decimal(18, 2)
  wholesalePrice Decimal?      @map("wholesale_price") @db.Decimal(18, 2)
  minStockAlert  Int           @default(5) @map("min_stock_alert")
  trackSerial    Boolean       @default(false) @map("track_serial")
  hasVariants    Boolean       @default(false) @map("has_variants")
  warrantyMonths Int?          @default(0) @map("warranty_months")
  warrantyPolicy String?       @map("warranty_policy")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  category          Category               @relation(fields: [categoryId], references: [id])
  brand             Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  barcodes          ProductBarcode[]
  images            ProductImage[]
  specifications    ProductSpecification[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  adjustmentItems   StockAdjustmentItem[]
  transferItems     StockTransferItem[]
  damagedProducts     DamagedProduct[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  orderItems          OrderItem[]
  reviews             ProductReview[]
  warrantyClaims      WarrantyClaim[]
  bundlePrimaryProducts GiftBundleItem[] @relation("BundlePrimaryProducts")
  bundleGiftProducts  GiftBundleItem[]   @relation("BundleGiftProducts")

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([sku])
  @@map("products")
}

model ProductVariant {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  name           String
  sku            String    @unique
  barcode        String?   @unique
  costPrice      Decimal?  @map("cost_price") @db.Decimal(18, 2)
  sellingPrice   Decimal?  @map("selling_price") @db.Decimal(18, 2)
  wholesalePrice Decimal?  @map("wholesale_price") @db.Decimal(18, 2)
  minStockAlert  Int?      @map("min_stock_alert")
  image          String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  product           Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues   ProductVariantAttributeValue[]
  barcodes          ProductBarcode[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  adjustmentItems   StockAdjustmentItem[]
  transferItems     StockTransferItem[]
  damagedProducts     DamagedProduct[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  orderItems          OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductVariantAttributeValue {
  id               String @id @default(uuid())
  variantId        String @map("variant_id")
  attributeValueId String @map("attribute_value_id")

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@map("product_variant_attribute_values")
}

model ProductBarcode {
  id        String      @id @default(uuid())
  productId String      @map("product_id")
  variantId String?     @map("variant_id")
  barcode   String      @unique
  isPrimary Boolean     @default(true) @map("is_primary")
  type      BarcodeType @default(CODE128)
  createdAt DateTime    @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_barcodes")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  fileId    String?  @map("file_id")
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    FileRecord? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_images")
}

model SpecificationGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  specifications ProductSpecification[]

  @@map("specification_groups")
}

model ProductSpecification {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  groupId   String? @map("group_id")
  key       String
  value     String
  sortOrder Int     @default(0) @map("sort_order")

  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   SpecificationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_specifications")
}


// ---------------------------------------------------------------------------
// Phase 3: People & Ledgers (Customers & Suppliers)
// ---------------------------------------------------------------------------

enum LedgerEntryType {
  OPENING_BALANCE
  SALE
  PURCHASE
  PAYMENT
  RETURN
  ADJUSTMENT
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  phone       String    @unique
  email       String?
  address     String?
  city        String?
  postalCode  String?   @map("postal_code")
  notes       String?
  creditLimit Decimal?  @map("credit_limit") @db.Decimal(18, 2)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ledgerEntries CustomerLedgerEntry[]
  sales         Sale[]
  saleReturns   SaleReturn[]
  orders        Order[]
  couponUsages  CouponUsage[]
  reviews       ProductReview[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

model CustomerLedgerEntry {
  id            String          @id @default(uuid())
  customerId    String          @map("customer_id")
  branchId      String?         @map("branch_id")
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(18, 2)
  debit         Decimal         @default(0) @db.Decimal(18, 2)
  credit        Decimal         @default(0) @db.Decimal(18, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(18, 2)
  referenceType String?         @map("reference_type")
  referenceId   String?         @map("reference_id")
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@map("customer_ledger_entries")
}

model Supplier {
  id            String    @id @default(uuid())
  companyName   String    @map("company_name")
  contactPerson String?   @map("contact_person")
  phone         String    @unique
  email         String?
  address       String?
  taxNumber     String?   @map("tax_number")
  tradeLicense  String?   @map("trade_license")
  notes         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  ledgerEntries    SupplierLedgerEntry[]
  purchases        Purchase[]
  purchaseReturns  PurchaseReturn[]
  purchasePayments PurchasePayment[]

  @@index([phone])
  @@index([companyName])
  @@map("suppliers")
}

model SupplierLedgerEntry {
  id            String          @id @default(uuid())
  supplierId    String          @map("supplier_id")
  branchId      String?         @map("branch_id")
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(18, 2)
  debit         Decimal         @default(0) @db.Decimal(18, 2)
  credit        Decimal         @default(0) @db.Decimal(18, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(18, 2)
  referenceType String?         @map("reference_type")
  referenceId   String?         @map("reference_id")
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@map("supplier_ledger_entries")
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIVED
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
  GIFT_OUT
  RESERVED
  RESERVATION_RELEASE
}

enum AdjustmentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

model InventoryBalance {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id")
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  inTransit   Int      @default(0) @map("in_transit")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@map("inventory_balances")
}

model StockMovement {
  id            String            @id @default(uuid())
  warehouseId   String            @map("warehouse_id")
  productId     String            @map("product_id")
  variantId     String?           @map("variant_id")
  type          StockMovementType
  quantity      Int
  balanceBefore Int               @map("balance_before")
  balanceAfter  Int               @map("balance_after")
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  batchNumber   String?           @map("batch_number")
  serialNumbers String[]          @default([]) @map("serial_numbers")
  reason        String?
  createdById   String?           @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockAdjustment {
  id               String           @id @default(uuid())
  adjustmentNumber String           @unique @map("adjustment_number")
  warehouseId      String           @map("warehouse_id")
  reason           String
  status           AdjustmentStatus @default(DRAFT)
  notes            String?
  createdById      String?          @map("created_by_id")
  confirmedById    String?          @map("confirmed_by_id")
  confirmedAt      DateTime?        @map("confirmed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("AdjustmentsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy User?                 @relation("AdjustmentsConfirmed", fields: [confirmedById], references: [id], onDelete: SetNull)
  items       StockAdjustmentItem[]

  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String          @id @default(uuid())
  adjustmentId String          @map("adjustment_id")
  productId    String          @map("product_id")
  variantId    String?         @map("variant_id")
  quantity     Int
  type         AdjustmentType
  reason       String?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
  @@index([productId])
  @@index([variantId])
  @@map("stock_adjustment_items")
}

model StockTransfer {
  id                     String         @id @default(uuid())
  transferNumber         String         @unique @map("transfer_number")
  sourceWarehouseId      String         @map("source_warehouse_id")
  destinationWarehouseId String         @map("destination_warehouse_id")
  status                 TransferStatus @default(DRAFT)
  notes                  String?
  createdById            String?        @map("created_by_id")
  dispatchedById         String?        @map("dispatched_by_id")
  dispatchedAt           DateTime?      @map("dispatched_at")
  receivedById           String?        @map("received_by_id")
  receivedAt             DateTime?      @map("received_at")
  cancelledById          String?        @map("cancelled_by_id")
  cancelledAt            DateTime?      @map("cancelled_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  sourceWarehouse      Warehouse           @relation("SourceTransfers", fields: [sourceWarehouseId], references: [id], onDelete: Cascade)
  destinationWarehouse Warehouse           @relation("DestinationTransfers", fields: [destinationWarehouseId], references: [id], onDelete: Cascade)
  createdBy            User?               @relation("TransfersCreated", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchedBy         User?               @relation("TransfersDispatched", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy           User?               @relation("TransfersReceived", fields: [receivedById], references: [id], onDelete: SetNull)
  cancelledBy          User?               @relation("TransfersCancelled", fields: [cancelledById], references: [id], onDelete: SetNull)
  items                StockTransferItem[]

  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String  @id @default(uuid())
  transferId String  @map("transfer_id")
  productId  String  @map("product_id")
  variantId  String? @map("variant_id")
  quantity   Int

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

model DamagedProduct {
  id            String   @id @default(uuid())
  damageNumber  String   @unique @map("damage_number")
  warehouseId   String   @map("warehouse_id")
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  quantity      Int
  serialNumbers String[] @default([]) @map("serial_numbers")
  reason        String
  actionTaken   String?  @map("action_taken")
  reportedById  String?  @map("reported_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reportedBy User?           @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
  @@map("damaged_products")
}

// ---------------------------------------------------------------------------
// Phase 5: Purchases & Purchase Returns
// ---------------------------------------------------------------------------

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PurchaseReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Purchase {
  id             String                @id @default(uuid())
  purchaseNumber String                @unique @map("purchase_number")
  supplierId     String                @map("supplier_id")
  warehouseId    String                @map("warehouse_id")
  branchId       String?               @map("branch_id")
  status         PurchaseStatus        @default(DRAFT)
  paymentStatus  PurchasePaymentStatus @default(UNPAID) @map("payment_status")
  orderDate      DateTime              @default(now()) @map("order_date")
  expectedDate   DateTime?             @map("expected_date")
  receivedDate   DateTime?             @map("received_date")
  subtotal       Decimal               @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal               @default(0) @map("tax_amount") @db.Decimal(18, 2)
  discountAmount Decimal               @default(0) @map("discount_amount") @db.Decimal(18, 2)
  shippingCost   Decimal               @default(0) @map("shipping_cost") @db.Decimal(18, 2)
  totalAmount    Decimal               @default(0) @map("total_amount") @db.Decimal(18, 2)
  paidAmount     Decimal               @default(0) @map("paid_amount") @db.Decimal(18, 2)
  dueAmount      Decimal               @default(0) @map("due_amount") @db.Decimal(18, 2)
  invoiceNumber  String?               @map("invoice_number")
  notes          String?
  createdById    String?               @map("created_by_id")
  receivedById   String?               @map("received_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  supplier    Supplier          @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("PurchasesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  receivedBy  User?             @relation("PurchasesReceived", fields: [receivedById], references: [id], onDelete: SetNull)
  items       PurchaseItem[]
  payments    PurchasePayment[]
  returns     PurchaseReturn[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id               String   @id @default(uuid())
  purchaseId       String   @map("purchase_id")
  productId        String   @map("product_id")
  variantId        String?  @map("variant_id")
  orderedQuantity  Int      @map("ordered_quantity")
  receivedQuantity Int      @default(0) @map("received_quantity")
  unitCost         Decimal  @db.Decimal(18, 2) @map("unit_cost")
  totalCost        Decimal  @db.Decimal(18, 2) @map("total_cost")
  batchNumber      String?  @map("batch_number")
  serialNumbers    String[] @default([]) @map("serial_numbers")

  purchase Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
  @@index([variantId])
  @@map("purchase_items")
}

model PurchasePayment {
  id            String   @id @default(uuid())
  paymentNumber String   @unique @map("payment_number")
  purchaseId    String   @map("purchase_id")
  supplierId    String   @map("supplier_id")
  amount        Decimal  @db.Decimal(18, 2)
  paymentMethod String   @map("payment_method")
  reference     String?
  paymentDate   DateTime @default(now()) @map("payment_date")
  notes         String?
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([supplierId])
  @@index([paymentDate])
  @@map("purchase_payments")
}

model PurchaseReturn {
  id           String               @id @default(uuid())
  returnNumber String               @unique @map("return_number")
  purchaseId   String?              @map("purchase_id")
  supplierId   String               @map("supplier_id")
  warehouseId  String               @map("warehouse_id")
  status       PurchaseReturnStatus @default(COMPLETED)
  totalAmount  Decimal              @db.Decimal(18, 2) @map("total_amount")
  reason       String
  notes        String?
  createdById  String?              @map("created_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  purchase  Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseReturnItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([purchaseId])
  @@index([createdAt])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id            String   @id @default(uuid())
  returnId      String   @map("return_id")
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  quantity      Int
  unitCost      Decimal  @db.Decimal(18, 2) @map("unit_cost")
  totalCost     Decimal  @db.Decimal(18, 2) @map("total_cost")
  serialNumbers String[] @default([]) @map("serial_numbers")

  return  PurchaseReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@index([productId])
  @@index([variantId])
  @@map("purchase_return_items")
}

// ---------------------------------------------------------------------------
// Phase 6: POS Sales & Cash Register Shifts
// ---------------------------------------------------------------------------

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum SaleChannel {
  POS
  ECOMMERCE
  DIRECT
}

enum SaleReturnStatus {
  COMPLETED
  CANCELLED
}

model CashRegisterShift {
  id                  String      @id @default(uuid())
  shiftNumber         String      @unique @map("shift_number")
  branchId            String      @map("branch_id")
  userId              String      @map("user_id")
  status              ShiftStatus @default(OPEN)
  openingCashFloat    Decimal     @default(0) @map("opening_cash_float") @db.Decimal(18, 2)
  closingCashExpected Decimal?    @map("closing_cash_expected") @db.Decimal(18, 2)
  closingCashActual   Decimal?    @map("closing_cash_actual") @db.Decimal(18, 2)
  cashDifference      Decimal?    @map("cash_difference") @db.Decimal(18, 2)
  openedAt            DateTime    @default(now()) @map("opened_at")
  closedAt            DateTime?   @map("closed_at")
  openingNotes        String?     @map("opening_notes")
  closingNotes        String?     @map("closing_notes")

  branch        Branch              @relation(fields: [branchId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  sales         Sale[]
  cashMovements ShiftCashMovement[]
  returns       SaleReturn[]

  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([openedAt])
  @@map("cash_register_shifts")
}

model ShiftCashMovement {
  id          String           @id @default(uuid())
  shiftId     String           @map("shift_id")
  type        CashMovementType
  amount      Decimal          @db.Decimal(18, 2)
  reason      String
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  shift     CashRegisterShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([type])
  @@map("shift_cash_movements")
}

model Sale {
  id             String      @id @default(uuid())
  invoiceNumber  String      @unique @map("invoice_number")
  branchId       String      @map("branch_id")
  warehouseId    String      @map("warehouse_id")
  customerId     String?     @map("customer_id")
  shiftId        String?     @map("shift_id")
  userId         String      @map("user_id")
  channel        SaleChannel @default(POS)
  status         SaleStatus  @default(COMPLETED)
  subtotal       Decimal     @db.Decimal(18, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount      Decimal     @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount    Decimal     @db.Decimal(18, 2) @map("total_amount")
  paidAmount     Decimal     @default(0) @map("paid_amount") @db.Decimal(18, 2)
  changeAmount   Decimal     @default(0) @map("change_amount") @db.Decimal(18, 2)
  dueAmount      Decimal     @default(0) @map("due_amount") @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  branch    Branch             @relation(fields: [branchId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shift     CashRegisterShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  user      User               @relation("SalesCreated", fields: [userId], references: [id])
  items     SaleItem[]
  payments  SalePayment[]
  returns   SaleReturn[]
  warrantyClaims WarrantyClaim[]

  @@index([branchId])
  @@index([warehouseId])
  @@index([customerId])
  @@index([shiftId])
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id                String    @id @default(uuid())
  saleId            String    @map("sale_id")
  productId         String    @map("product_id")
  variantId         String?   @map("variant_id")
  quantity          Int
  unitPrice         Decimal   @db.Decimal(18, 2) @map("unit_price")
  costPriceSnapshot Decimal   @default(0) @db.Decimal(18, 2) @map("cost_price_snapshot")
  discountAmount    Decimal   @default(0) @map("discount_amount") @db.Decimal(18, 2)
  totalPrice        Decimal   @db.Decimal(18, 2) @map("total_price")
  serialNumbers     String[]  @default([]) @map("serial_numbers")
  warrantyMonths    Int?      @default(0) @map("warranty_months")
  warrantyExpiresAt DateTime? @map("warranty_expires_at")

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@index([variantId])
  @@map("sale_items")
}

model SalePayment {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id")
  method    String
  amount    Decimal  @db.Decimal(18, 2)
  reference String?
  createdAt DateTime @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([method])
  @@map("sale_payments")
}

model SaleReturn {
  id           String           @id @default(uuid())
  returnNumber String           @unique @map("return_number")
  saleId       String           @map("sale_id")
  branchId     String           @map("branch_id")
  warehouseId  String           @map("warehouse_id")
  customerId   String?          @map("customer_id")
  shiftId      String?          @map("shift_id")
  status       SaleReturnStatus @default(COMPLETED)
  totalRefund  Decimal          @db.Decimal(18, 2) @map("total_refund")
  refundMethod String           @default("CASH") @map("refund_method")
  reason       String
  notes        String?
  createdById  String?          @map("created_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  sale      Sale               @relation(fields: [saleId], references: [id])
  branch    Branch             @relation(fields: [branchId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shift     CashRegisterShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     SaleReturnItem[]

  @@index([saleId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([customerId])
  @@index([shiftId])
  @@index([createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id            String   @id @default(uuid())
  returnId      String   @map("return_id")
  saleItemId    String?  @map("sale_item_id")
  productId     String   @map("product_id")
  variantId     String?  @map("variant_id")
  quantity      Int
  unitPrice     Decimal  @db.Decimal(18, 2) @map("unit_price")
  refundAmount  Decimal  @db.Decimal(18, 2) @map("refund_amount")
  serialNumbers String[] @default([]) @map("serial_numbers")
  reason        String?

  return  SaleReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@index([productId])
  @@index([variantId])
  @@map("sale_return_items")
}

// ---------------------------------------------------------------------------
// Phase 7: E-commerce Orders & State Workflow
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL_PAID
  PAID
  REFUNDED
}

enum OrderPaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
  BANK_TRANSFER
  OTHER
}

enum OrderSource {
  WEBSITE
  APP
  ADMIN_PANEL
  TELESALES
  SOCIAL_COMMERCE
}

model Order {
  id                  String             @id @default(uuid())
  orderNumber         String             @unique @map("order_number")
  customerId          String?            @map("customer_id")
  warehouseId         String             @map("warehouse_id")
  branchId            String?            @map("branch_id")
  partnerId           String?            @map("partner_id")
  status              OrderStatus        @default(PENDING)
  paymentStatus       OrderPaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod       OrderPaymentMethod @default(COD) @map("payment_method")
  source              OrderSource        @default(WEBSITE)
  customerName        String             @map("customer_name")
  customerPhone       String             @map("customer_phone")
  customerEmail       String?            @map("customer_email")
  shippingAddress     String             @map("shipping_address")
  shippingCity        String?            @map("shipping_city")
  shippingZone        String?            @map("shipping_zone")
  subtotal            Decimal            @db.Decimal(18, 2)
  shippingCost        Decimal            @default(0) @map("shipping_cost") @db.Decimal(18, 2)
  discountAmount      Decimal            @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount           Decimal            @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount         Decimal            @db.Decimal(18, 2) @map("total_amount")
  paidAmount          Decimal            @default(0) @map("paid_amount") @db.Decimal(18, 2)
  dueAmount           Decimal            @db.Decimal(18, 2) @map("due_amount")
  isReserved          Boolean            @default(false) @map("is_reserved")
  isStockDeducted     Boolean            @default(false) @map("is_stock_deducted")
  courierName         String?            @map("courier_name")
  courierTrackingCode String?            @map("courier_tracking_code")
  notes               String?
  createdById         String?            @map("created_by_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id])
  branch        Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  partner       Partner?             @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("OrdersCreated", fields: [createdById], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      OrderPayment[]
  shipments     CourierShipment[]
  couponUsages  CouponUsage[]
  telesalesLeads TelesalesLead[]     @relation("TelesalesOrder")

  @@index([customerId])
  @@index([warehouseId])
  @@index([branchId])
  @@index([partnerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerPhone])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  productId         String   @map("product_id")
  variantId         String?  @map("variant_id")
  quantity          Int
  unitPrice         Decimal  @db.Decimal(18, 2) @map("unit_price")
  costPriceSnapshot Decimal  @default(0) @db.Decimal(18, 2) @map("cost_price_snapshot")
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 2)
  totalPrice        Decimal  @db.Decimal(18, 2) @map("total_price")
  serialNumbers     String[] @default([]) @map("serial_numbers")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  reason      String?
  notes       String?
  changedById String?      @map("changed_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
  @@map("order_status_history")
}

model OrderPayment {
  id            String             @id @default(uuid())
  paymentNumber String             @unique @map("payment_number")
  orderId       String             @map("order_id")
  amount        Decimal            @db.Decimal(18, 2)
  paymentMethod OrderPaymentMethod @map("payment_method")
  transactionId String?            @map("transaction_id")
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentMethod])
  @@map("order_payments")
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
  MANUAL
}

enum CourierDeliveryStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

model CourierShipment {
  id               String                @id @default(uuid())
  shipmentNumber   String                @unique @map("shipment_number")
  orderId          String                @map("order_id")
  provider         CourierProvider
  consignmentId    String?               @map("consignment_id")
  trackingCode     String?               @map("tracking_code")
  status           CourierDeliveryStatus @default(PENDING)
  deliveryFee      Decimal               @default(0) @db.Decimal(18, 2) @map("delivery_fee")
  codAmount        Decimal               @default(0) @db.Decimal(18, 2) @map("cod_amount")
  recipientName    String                @map("recipient_name")
  recipientPhone   String                @map("recipient_phone")
  recipientAddress String                @map("recipient_address")
  recipientCity    String?               @map("recipient_city")
  recipientZone    String?               @map("recipient_zone")
  statusHistory    Json?                 @map("status_history")
  courierPayload   Json?                 @map("courier_payload")
  createdById      String?               @map("created_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ShipmentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([provider])
  @@index([trackingCode])
  @@index([consignmentId])
  @@index([status])
  @@index([createdAt])
  @@map("courier_shipments")
}

// ---------------------------------------------------------------------------
// Phase 9: Payments, Expenses & Cash Accounts
// ---------------------------------------------------------------------------

enum CashAccountType {
  CASH
  BANK
  MFS
}

enum CashTransactionType {
  OPENING_BALANCE
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  EXPENSE
  SALE_PAYMENT
  PURCHASE_PAYMENT
  DIRECTOR_DEPOSIT
  DIRECTOR_WITHDRAWAL
  ADJUSTMENT
}

model CashAccount {
  id            String          @id @default(uuid())
  name          String
  type          CashAccountType @default(CASH)
  accountNumber String?         @map("account_number")
  bankName      String?         @map("bank_name")
  branchName    String?         @map("branch_name")
  balance       Decimal         @default(0) @db.Decimal(18, 2)
  branchId      String?         @map("branch_id")
  isActive      Boolean         @default(true) @map("is_active")
  isDefault     Boolean         @default(false) @map("is_default")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  branch            Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transactions      CashAccountTransaction[]
  expenses          Expense[]
  transfersReceived CashAccountTransaction[] @relation("TransferredAccounts")
  directorTransactions DirectorTransaction[]

  @@index([type])
  @@index([branchId])
  @@index([isActive])
  @@map("cash_accounts")
}

model CashAccountTransaction {
  id                String              @id @default(uuid())
  transactionNumber String              @unique @map("transaction_number")
  accountId         String              @map("account_id")
  type              CashTransactionType
  amount            Decimal             @db.Decimal(18, 2)
  balanceBefore     Decimal             @db.Decimal(18, 2) @map("balance_before")
  balanceAfter      Decimal             @db.Decimal(18, 2) @map("balance_after")
  referenceType     String?             @map("reference_type")
  referenceId       String?             @map("reference_id")
  transferAccountId String?             @map("transfer_account_id")
  description       String?
  createdById       String?             @map("created_by_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  account         CashAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount CashAccount? @relation("TransferredAccounts", fields: [transferAccountId], references: [id], onDelete: SetNull)
  createdBy       User?        @relation("CashTransactionsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("cash_account_transactions")
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@index([isActive])
  @@map("expense_categories")
}

model Expense {
  id            String   @id @default(uuid())
  expenseNumber String   @unique @map("expense_number")
  categoryId    String   @map("category_id")
  accountId     String   @map("account_id")
  branchId      String?  @map("branch_id")
  amount        Decimal  @db.Decimal(18, 2)
  expenseDate   DateTime @default(now()) @map("expense_date")
  payee         String?
  receiptFileId String?  @map("receipt_file_id")
  notes         String?
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  account     CashAccount     @relation(fields: [accountId], references: [id])
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  receiptFile FileRecord?     @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("ExpensesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([accountId])
  @@index([branchId])
  @@index([expenseDate])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Phase 10: Marketing & Storefront Admin Models
// ---------------------------------------------------------------------------

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BannerPosition {
  HERO
  SIDEBAR
  PROMO_STRIP
  POPUP
}

model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  type              CouponDiscountType @default(PERCENTAGE)
  value             Decimal            @db.Decimal(18, 2)
  minOrderAmount    Decimal            @default(0) @db.Decimal(18, 2) @map("min_order_amount")
  maxDiscountAmount Decimal?           @map("max_discount_amount") @db.Decimal(18, 2)
  usageLimit        Int?               @map("usage_limit")
  usedCount         Int                @default(0) @map("used_count")
  perCustomerLimit  Int?               @default(1) @map("per_customer_limit")
  startDate         DateTime           @map("start_date")
  endDate           DateTime           @map("end_date")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  usages CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  orderId        String?  @map("order_id")
  customerId     String?  @map("customer_id")
  discountAmount Decimal  @db.Decimal(18, 2) @map("discount_amount")
  usedAt         DateTime @default(now()) @map("used_at")

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([orderId])
  @@index([customerId])
  @@map("coupon_usages")
}

model PromotionOffer {
  id                 String    @id @default(uuid())
  title              String
  slug               String    @unique
  description        String?
  bannerFileId       String?   @map("banner_file_id")
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  startDate          DateTime  @map("start_date")
  endDate            DateTime  @map("end_date")
  isActive           Boolean   @default(true) @map("is_active")
  productIds         String[]  @default([]) @map("product_ids")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  bannerFile FileRecord? @relation(fields: [bannerFileId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("promotion_offers")
}

model StorefrontBanner {
  id          String         @id @default(uuid())
  title       String
  subtitle    String?
  linkUrl     String?        @map("link_url")
  imageFileId String         @map("image_file_id")
  position    BannerPosition @default(HERO)
  sortOrder   Int            @default(0) @map("sort_order")
  isActive    Boolean        @default(true) @map("is_active")
  startDate   DateTime?      @map("start_date")
  endDate     DateTime?      @map("end_date")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  imageFile FileRecord @relation(fields: [imageFileId], references: [id], onDelete: Cascade)

  @@index([position])
  @@index([isActive])
  @@map("storefront_banners")
}

model ProductReview {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  customerId   String?  @map("customer_id")
  reviewerName String   @map("reviewer_name")
  rating       Int      @default(5)
  title        String?
  comment      String
  isApproved   Boolean  @default(false) @map("is_approved")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([customerId])
  @@index([isApproved])
  @@map("product_reviews")
}

// ---------------------------------------------------------------------------
// Phase 11: Gadget-Specific Workflows Models
// ---------------------------------------------------------------------------

enum DeviceCondition {
  MINT
  GOOD
  FAIR
  POOR
}

enum BuybackStatus {
  PENDING
  INSPECTED
  ACCEPTED
  REJECTED
  PURCHASED
}

enum WarrantyClaimStatus {
  RECEIVED
  DIAGNOSING
  SENT_TO_SERVICE_CENTER
  REPAIRED
  REPLACED
  REJECTED
  DELIVERED_TO_CUSTOMER
}

model DeviceBuybackRequest {
  id              String          @id @default(uuid())
  requestNumber   String          @unique @map("request_number")
  customerName    String          @map("customer_name")
  customerPhone   String          @map("customer_phone")
  deviceBrand     String          @map("device_brand")
  deviceModel     String          @map("device_model")
  imei            String?
  serialNumber    String?         @map("serial_number")
  condition       DeviceCondition @default(GOOD)
  batteryHealth   Int?            @map("battery_health")
  hasBox          Boolean         @default(false) @map("has_box")
  hasCharger      Boolean         @default(false) @map("has_charger")
  hasOriginalBill Boolean         @default(false) @map("has_original_bill")
  expectedPrice   Decimal?        @map("expected_price") @db.Decimal(18, 2)
  offeredPrice    Decimal?        @map("offered_price") @db.Decimal(18, 2)
  status          BuybackStatus   @default(PENDING)
  notes           String?
  inspectedById   String?         @map("inspected_by_id")
  createdById     String?         @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  inspectedBy User? @relation("BuybacksInspected", fields: [inspectedById], references: [id], onDelete: SetNull)
  createdBy   User? @relation("BuybacksCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerPhone])
  @@index([imei])
  @@index([serialNumber])
  @@index([status])
  @@map("device_buyback_requests")
}

model WarrantyClaim {
  id              String              @id @default(uuid())
  claimNumber     String              @unique @map("claim_number")
  customerName    String              @map("customer_name")
  customerPhone   String              @map("customer_phone")
  serialNumber    String              @map("serial_number")
  productId       String?             @map("product_id")
  saleId          String?             @map("sale_id")
  problemSummary  String              @map("problem_summary")
  status          WarrantyClaimStatus @default(RECEIVED)
  repairCost      Decimal             @default(0) @db.Decimal(18, 2) @map("repair_cost")
  receivedDate    DateTime            @default(now()) @map("received_date")
  estimatedDate   DateTime?           @map("estimated_date")
  completedDate   DateTime?           @map("completed_date")
  technicianNotes String?             @map("technician_notes")
  createdById     String?             @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("WarrantyClaimsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerPhone])
  @@index([serialNumber])
  @@index([status])
  @@map("warranty_claims")
}

model GiftBundle {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items GiftBundleItem[]

  @@map("gift_bundles")
}

model GiftBundleItem {
  id               String  @id @default(uuid())
  bundleId         String  @map("bundle_id")
  primaryProductId String  @map("primary_product_id")
  giftProductId    String  @map("gift_product_id")
  giftQuantity     Int     @default(1) @map("gift_quantity")

  bundle         GiftBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  primaryProduct Product    @relation("BundlePrimaryProducts", fields: [primaryProductId], references: [id], onDelete: Cascade)
  giftProduct    Product    @relation("BundleGiftProducts", fields: [giftProductId], references: [id], onDelete: Cascade)

  @@unique([bundleId, primaryProductId, giftProductId])
  @@map("gift_bundle_items")
}

// ---------------------------------------------------------------------------
// Phase 12: Telesales & Confirmation Models
// ---------------------------------------------------------------------------

enum LeadSource {
  FACEBOOK
  WEBSITE
  WHATSAPP
  PHONE_CALL
  WALK_IN
  OTHER
}

enum LeadDisposition {
  NEW
  INTERESTED
  CONFIRMED
  CALLBACK_REQUESTED
  UNREACHABLE
  CANCELLED
  WRONG_NUMBER
}

model TelesalesLead {
  id               String          @id @default(uuid())
  leadNumber       String          @unique @map("lead_number")
  customerName     String          @map("customer_name")
  phone            String
  alternatePhone   String?         @map("alternate_phone")
  email            String?
  source           LeadSource      @default(WEBSITE)
  disposition      LeadDisposition @default(NEW)
  address          String?
  city             String?
  notes            String?
  callbackAt       DateTime?       @map("callback_at")
  assignedAgentId  String?         @map("assigned_agent_id")
  convertedOrderId String?         @map("converted_order_id")
  createdById      String?         @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  assignedAgent    User?               @relation("AssignedTelesalesLeads", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("CreatedTelesalesLeads", fields: [createdById], references: [id], onDelete: SetNull)
  convertedOrder   Order?              @relation("TelesalesOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  callLogs         TelesalesCallLog[]

  @@index([phone])
  @@index([disposition])
  @@index([assignedAgentId])
  @@index([createdAt])
  @@map("telesales_leads")
}

model TelesalesCallLog {
  id                  String          @id @default(uuid())
  leadId              String          @map("lead_id")
  agentId             String          @map("agent_id")
  disposition         LeadDisposition
  callDurationSeconds Int             @default(0) @map("call_duration_seconds")
  notes               String?
  callbackAt          DateTime?       @map("callback_at")
  createdAt           DateTime        @default(now()) @map("created_at")

  lead                TelesalesLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent               User            @relation("TelesalesAgentLogs", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([agentId])
  @@index([createdAt])
  @@map("telesales_call_logs")
}

// ---------------------------------------------------------------------------
// Phase 13: Partner Network (Dealers, Retailers, B2B, Franchises) Models
// ---------------------------------------------------------------------------

enum PartnerType {
  DEALER
  RETAILER
  B2B
  FRANCHISE
}

enum PartnerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum PartnerLedgerType {
  INVOICE
  PAYMENT
  COMMISSION
  ADJUSTMENT
}

model PartnerPriceTier {
  id                 String    @id @default(uuid())
  name               String    @unique
  discountPercentage Decimal   @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  description        String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  partners           Partner[]

  @@map("partner_price_tiers")
}

model Partner {
  id                 String             @id @default(uuid())
  partnerNumber      String             @unique @map("partner_number")
  companyName        String             @map("company_name")
  contactPerson      String             @map("contact_person")
  phone              String             @unique
  email              String?            @unique
  address            String
  city               String?
  type               PartnerType        @default(RETAILER)
  status             PartnerStatus      @default(PENDING)
  priceTierId        String?            @map("price_tier_id")
  creditLimit        Decimal            @default(0) @map("credit_limit") @db.Decimal(18, 2)
  outstandingBalance Decimal            @default(0) @map("outstanding_balance") @db.Decimal(18, 2)
  commissionRate     Decimal            @default(0) @map("commission_rate") @db.Decimal(5, 2)
  tradeLicense       String?            @map("trade_license")
  binNumber          String?            @map("bin_number")
  nidNumber          String?            @map("nid_number")
  branchId           String?            @map("branch_id")
  createdById        String?            @map("created_by_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  priceTier          PartnerPriceTier?  @relation(fields: [priceTierId], references: [id], onDelete: SetNull)
  branch             Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy          User?              @relation("PartnersCreated", fields: [createdById], references: [id], onDelete: SetNull)
  ledgerEntries      PartnerLedgerEntry[]
  orders             Order[]

  @@index([phone])
  @@index([type])
  @@index([status])
  @@map("partners")
}

model PartnerLedgerEntry {
  id            String            @id @default(uuid())
  partnerId     String            @map("partner_id")
  type          PartnerLedgerType
  amount        Decimal           @db.Decimal(18, 2)
  balanceBefore Decimal           @db.Decimal(18, 2) @map("balance_before")
  balanceAfter  Decimal           @db.Decimal(18, 2) @map("balance_after")
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  notes         String?
  createdById   String?           @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  partner       Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("PartnerLedgerCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([type])
  @@index([createdAt])
  @@map("partner_ledger_entries")
}

// ---------------------------------------------------------------------------
// Phase 14: Director / Owner Treasury Models
// ---------------------------------------------------------------------------

enum DirectorTxType {
  CAPITAL_DEPOSIT
  DRAWING_WITHDRAWAL
  PROFIT_SHARE
}

model Director {
  id               String                @id @default(uuid())
  name             String
  phone            String                @unique
  nid              String?               @unique
  email            String?
  sharePercentage  Decimal               @default(0) @map("share_percentage") @db.Decimal(5, 2)
  totalDeposited   Decimal               @default(0) @map("total_deposited") @db.Decimal(18, 2)
  totalWithdrawn   Decimal               @default(0) @map("total_withdrawn") @db.Decimal(18, 2)
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  transactions     DirectorTransaction[]

  @@map("directors")
}

model DirectorTransaction {
  id                String          @id @default(uuid())
  transactionNumber String          @unique @map("transaction_number")
  directorId        String          @map("director_id")
  accountId         String          @map("account_id")
  type              DirectorTxType
  amount            Decimal         @db.Decimal(18, 2)
  notes             String?
  createdById       String?         @map("created_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")

  director          Director        @relation(fields: [directorId], references: [id], onDelete: Cascade)
  account           CashAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy         User?           @relation("DirectorTxCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([directorId])
  @@index([accountId])
  @@index([type])
  @@index([createdAt])
  @@map("director_transactions")
}
