# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
API_PREFIX=api/v1
APP_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL
# These values are also used by docker-compose.yml.
# ---------------------------------------------------------------------------
POSTGRES_USER=pos
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=pos_erp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pos:replace-with-a-strong-password@localhost:5432/pos_erp?schema=public

# ---------------------------------------------------------------------------
# Redis
# docker-compose maps host port 6380 to container port 6379 because the
# system Redis on this machine already listens on 6379. Set REDIS_PORT=6379
# if you intentionally use the system Redis instead.
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# JWT
# Generate with: openssl rand -base64 48
# Access and refresh secrets must be different.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-bytes
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=erp-pos
JWT_AUDIENCE=erp-pos-api

# ---------------------------------------------------------------------------
# MinIO / S3-compatible object storage
# The bucket is private; clients receive short-lived presigned URLs.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret
MINIO_BUCKET=pos-erp
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=10

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
